# Copy to .env and fill in. Never commit the real .env.
#
# The app looks for .env in two places, in this order:
#   1. this repo's own folder
#   2. the folder one level above the repo
#
# Course key - this is the only key the app needs at runtime.
PORTKEY_API_KEY=

# Optional: only if you run the app on your own OpenAI account instead.
OPENAI_API_KEY=
