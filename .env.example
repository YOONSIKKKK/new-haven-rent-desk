# Copy to .env and fill in. Never commit the real .env.
#
# The app looks for .env in two places, in this order:
#   1. this repo's own folder
#   2. the folder one level above the repo
#
# Course key - this is the only key the app needs at runtime.
PORTKEY_API_KEY=

# Optional: only if you run the app on your own OpenAI account instead.
OPENAI_API_KEY=

# Optional. Only affects the review screen at /admin, which is where submitted
# viewer profiles are approved. Leave it unset and that screen is open, which is
# fine on localhost and says so on the page. Set it before putting this app on a
# network. The app itself runs without it.
ADMIN_TOKEN=
